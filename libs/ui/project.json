{
  "name": "@akashaorg/ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "targets": {
    "prepare": {
      "dependsOn": ["@akashaorg/typings:prepare"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui",
        "command": "tsc --build && tsc-alias"
      }
    },
    "test": {
      "dependsOn": ["prepare"]
    },
    "build": {
      "dependsOn": ["prepare"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/ui",
        "command": "copyfiles -f ./src/static/img/* ../../dist/images && tsc --build"
      },
      "outputs": ["{projectRoot}/lib", "{workspaceRoot}/dist/images"]
    }
  },
  "tags": ["scope:extension", "type:lib"]
}
